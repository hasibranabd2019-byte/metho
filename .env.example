PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres
DATABASE_SSL=require
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
# Generate: node -e "console.log(require('bcryptjs').hashSync('Use-A-Strong-Password', 12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Steadfast Merchant API credentials: set privately in Render Environment, never commit.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_API_BASE=https://portal.packzy.com/api/v1

# Initial administrator email (required for password recovery)
ADMIN_EMAIL=admin@example.com
# SMTP email delivery (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Metho Support <your-email@gmail.com>
# Supabase Storage image uploads
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=metho-assets
